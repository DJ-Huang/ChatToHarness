{
  "name": "chat-to-harness",
  "version": "0.3.1",
  "private": true,
  "description": "Connect AI chat to your local harness.",
  "author": "ChatToHarness contributors",
  "license": "MIT",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node scripts/prepare-resources.cjs",
    "build": "node scripts/build.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist": "node scripts/build.cjs --dist",
    "smoke:installer": "node scripts/installer-smoke.cjs",
    "smoke:ui": "node scripts/ui-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.0"
  },
  "build": {
    "appId": "local.localharness.mac",
    "productName": "ChatToHarness",
    "copyright": "Copyright \u00a9 2026 ChatToHarness contributors",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json",
      "README*.md",
      "ARCHITECTURE.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "VERIFICATION.md",
      "docs/**/*",
      "release-notes/**/*.md",
      "site/assets/*.png"
    ],
    "extraResources": [
      {
        "from": "resources/node",
        "to": "node"
      },
      {
        "from": "resources/tunnel",
        "to": "tunnel"
      },
      {
        "from": "resources/desktop-commander",
        "to": "desktop-commander"
      },
      {
        "from": "resources/desktop-commander/node_modules",
        "to": "desktop-commander/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bundle.json",
        "to": "bundle.json"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      },
      {
        "from": "resources/managed-process",
        "to": "managed-process",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "assets/ChatToHarness.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "ChatToHarness-${version}-macos-${arch}.${ext}",
      "binaries": [
        "Contents/Resources/node/bin/node",
        "Contents/Resources/tunnel/tunnel-client-runtime"
      ]
    },
    "win": {
      "icon": "assets/ChatToHarness.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ChatToHarness-${version}-windows-${arch}-setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "dmg": {
      "title": "ChatToHarness ${version}",
      "sign": false
    }
  },
  "homepage": "https://dj-huang.github.io/ChatToHarness/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DJ-Huang/ChatToHarness.git"
  }
}
